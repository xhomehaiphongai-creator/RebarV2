<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="THÉP CỘT CUR"
    Height="760"
    Width="1280"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True"
    Background="#F3F0FA">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#6F4DBF" CornerRadius="2">
            <DockPanel LastChildFill="True">
                <TextBlock Text="THÉP CỘT CUR"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="0,8,0,8"
                    Background="#FFFFFF"
                    BorderBrush="#D9D0EE"
                    x:Name="main_tab">
            <TabItem Header="HÌNH HỌC &amp; BỐ TRÍ THÉP">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.10*"/>
                        <ColumnDefinition Width="1.20*"/>
                        <ColumnDefinition Width="1.05*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="#CFC3E8"
                            BorderThickness="1"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#7E57C2">
                                <TextBlock Text="TẤT CẢ CỘT"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="8"
                                    BorderBrush="#CFC3E8"
                                    BorderThickness="1"
                                    Background="#F8F6FC">
                                <Canvas x:Name="canvas_preview" Background="#F8F6FC"/>
                            </Border>

                            <Border Grid.Row="2" Background="#FAF8FE" BorderBrush="#D9D0EE" BorderThickness="1,1,1,0">
                                <TextBlock x:Name="txt_selected_segment"
                                           Margin="8,0,8,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="#333333"
                                           Text="Đoạn đang chọn:"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- MIDDLE -->
                    <Border Grid.Column="1"
                            Background="White"
                            BorderBrush="#CFC3E8"
                            BorderThickness="1"
                            Margin="8,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#7E57C2">
                                <TextBlock Text="HIỆU CHỈNH CỐT THÉP"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Border>

                            <Grid Grid.Row="1" Margin="10,12,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Số lượng thép cạnh Cx:"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <ComboBox x:Name="cbo_cx"
                                          Grid.Row="0" Grid.Column="1"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          FontSize="14"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Số lượng thép cạnh Cy:"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <ComboBox x:Name="cbo_cy"
                                          Grid.Row="1" Grid.Column="1"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          FontSize="14"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Đường kính cốt thép chính:"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <ComboBox x:Name="cbo_main_bar"
                                          Grid.Row="2" Grid.Column="1"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          FontSize="14"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Đường kính cốt đai chính:"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <ComboBox x:Name="cbo_tie_bar"
                                          Grid.Row="3" Grid.Column="1"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          FontSize="14"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="Đường kính đai móc:"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <ComboBox x:Name="cbo_hook_bar"
                                          Grid.Row="4" Grid.Column="1"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          FontSize="14"/>

                                <TextBlock Grid.Row="6" Grid.ColumnSpan="2"
                                           Text="Bố trí đai"
                                           HorizontalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#5E35B1"/>

                                <TextBlock Grid.Row="7" Grid.Column="0"
                                           Text="Bố trí thép đai:"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <ComboBox x:Name="cbo_layout"
                                          Grid.Row="7" Grid.Column="1"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          FontSize="14"/>

                                <TextBlock Grid.Row="8" Grid.Column="0"
                                           Text="Bê tông bảo vệ vế trên (mm):"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <TextBox x:Name="txt_top_cover"
                                         Grid.Row="8" Grid.Column="1"
                                         Width="72"
                                         Height="28"
                                         VerticalContentAlignment="Center"
                                         Text="25"
                                         FontSize="14"
                                         HorizontalAlignment="Left"/>

                                <StackPanel Grid.Row="9" Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Tổng hợp số cốt thép:"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Margin="0,0,8,0"/>
                                    <TextBlock x:Name="txt_total_bar"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Text="4D18"
                                               Margin="0,0,24,0"/>

                                    <Button x:Name="btn_clear"
                                            Content="XOÁ TẤT CẢ"
                                            Width="100"
                                            Height="28"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT -->
                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#CFC3E8"
                            BorderThickness="1"
                            Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#7E57C2">
                                <TextBlock Text="MẶT CẮT CỘT"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Border>

                            <Grid Grid.Row="1" Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Mặt cắt cột"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#5E35B1"/>

                                <Border Grid.Row="1"
                                        Margin="0,8,0,0"
                                        BorderBrush="#7E57C2"
                                        BorderThickness="2"
                                        Background="#F8F6FC">
                                    <Canvas x:Name="canvas_section"
                                            Margin="8"
                                            Background="#F8F6FC"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="CÀI ĐẶT CHUNG">
                <ContentControl x:Name="settings_host"/>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btn_save"
                    Grid.Column="1"
                    Width="110"
                    Height="38"
                    Content="SAVE"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"/>

            <Button x:Name="btn_apply_all"
                    Grid.Column="2"
                    Width="220"
                    Height="38"
                    Content="ÁP DỤNG CHO CỘT"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>

            <Button x:Name="btn_run"
                    Grid.Column="3"
                    Width="90"
                    Height="38"
                    Content="CHẠY"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"/>

            <Button x:Name="btn_close"
                    Grid.Column="4"
                    Width="90"
                    Height="38"
                    Content="ĐÓNG"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>